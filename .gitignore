__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Licensed Bloomberg data: must never be committed.
# Keep folders, ignore all contents.
data/raw/*
data/processed/*
!data/**/.gitkeep

# Safety net: data files anywhere in the repo (e.g. exports saved in notebooks/)
*.csv
*.xlsx
*.xls
*.parquet
*.pkl
*.pickle
*.feather
*.h5
*.hdf5

# Exception: derived backtest results (strategy statistics only, no raw data)
!reports/*.csv

reports/
report/
# LaTeX build files
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
docs/
